# --- required ---
CLUB_NAME=Crypto Club
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# shared invite code, usable any number of times; leave empty to allow only the
# one-time codes generated on the Admin page (one account per code)
INVITE_CODE=change-me

# --- market (defaults shown) ---
# FEED=sim gives random fake prices for offline development
FEED=kraken
SYMBOLS=BTC/USD,ETH/USD,SOL/USD,XRP/USD,DOGE/USD,ADA/USD,LINK/USD,LTC/USD
START_BALANCE=100000
# Kraken's entry-tier spot fees
MAKER_FEE=0.0025
TAKER_FEE=0.004

# --- realism knobs (defaults shown) ---
# delay before an order reaches the book
LATENCY_MIN_MS=50
LATENCY_MAX_MS=200
# how long liquidity eaten by a student stays "used up"
LIQUIDITY_TTL_MS=30000
# pause trading if the feed is silent this long
STALE_MS=5000
BOOK_DEPTH=100
# 1 = every order must include a "why this trade?" note
REQUIRE_NOTE=0
# equity curve sampling interval
SNAPSHOT_SECS=300
MAX_OPEN_ORDERS=100
ORDERS_PER_SEC=10
